PORT=3000
# Database aplikasi utama. Wajib tersedia untuk deployment yang memakai PostgreSQL.
DATABASE_URL=postgresql://user:password@127.0.0.1:5432/database_name
# Database/schema yang dipakai khusus retrieval RAG. Dapat memakai DSN yang sama.
RAG_DATABASE_URL=postgresql://user:password@127.0.0.1:5432/database_name
RAG_STORAGE=postgres
# Optional: when set, POST /api/reindex requires Authorization: Bearer <token>.
RAG_REINDEX_TOKEN=
# LiteLLM OpenAI-compatible proxy backed by the authenticated GitHub Copilot
# session mounted through LITELLM_AUTH_DIR. Keep credentials outside Git.
LITELLM_BASE_URL=http://localhost:4000/v1
LITELLM_API_KEY=
LITELLM_MASTER_KEY=sk-sdm-rag-local
# This is the proxy alias declared in litellm.config.yaml.
LITELLM_MODEL=copilot-rag
# Upstream provider model consumed by the alias; override only when the
# authenticated Copilot account exposes another compatible model.
LITELLM_COPILOT_MODEL=github_copilot/gpt-5-mini
# Upload limits: 25 MiB and 2 upload requests per 60 seconds by default.
RAG_UPLOAD_MAX_BYTES=26214400
RAG_RATE_LIMIT_UPLOAD_MAX=2
# Host directory containing the LiteLLM/Copilot auth cache.
LITELLM_AUTH_DIR=/home/cicero/.config/litellm
