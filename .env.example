PORT=3000
# LiteLLM OpenAI-compatible proxy backed by Gemini.
# Keep the real key outside Git; inject it at runtime.
LITELLM_BASE_URL=http://localhost:4000/v1
LITELLM_API_KEY=
LITELLM_MODEL=gemini-rag
# Alias accepted when LiteLLM is configured to read the Gemini key directly.
GEMINI_API_KEY=
# Legacy generic names are also accepted.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
